{
  "name": "video-harness-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "video-harness 渲染引擎（Remotion）：runtime + theme；积木在 ../library",
  "scripts": {
    "index": "tsx scripts/build-index.ts",
    "render": "tsx scripts/render.ts",
