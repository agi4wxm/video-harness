{
  "schema": "0.1.0",
  "assets": [
    {
      "id": "block/footage-window@0.1.0",
      "kind": "block",
      "title": "素材窗口",
      "summary": "图片或视频填满内容区，缓慢推拉 / 平移，可在指定时刻弹出标注、描出高亮框",
      "tags": {
        "shot_type": [
          "live-footage",
          "screenshot",
          "generative-footage"
        ],
        "metaphor": [
          "zoom-detail",
          "none"
        ],
        "emphasis_treatment": [
          "box",
          "motion-pop"
        ],
        "aspect": [
          "9:16",
          "16:9"
        ]
      },
      "entry": "./index.tsx",
      "params_schema": "./schema.ts",
      "constraints": {
        "duration_s": [
          1,
          5
        ]
      },
      "examples": [
        {
          "name": "充电特写",
          "duration_s": 3,
          "params": {
            "src": "assets/media.image/phone-charging/phone-charging.webp",
            "move": "in",
            "focus": {
              "x": 0.5,
              "y": 0.45
            },
            "callouts": [
              {
                "at": 0.8,
                "text": "80%",
                "x": 0.5,
                "y": 0.3,
                "color": "accent2"
              }
            ]
          }
        }
      ],
      "deps": [
        "media.image/phone-charging@0.1.0"
      ],
      "implements": [
        "recipe/literal-illustration"
      ],
      "provenance": {
        "source": "self-made",
        "license": "自有",
        "reference": "analysis/chaping（live-footage 段 46%：一句话一画面的直译）"
      },
      "quality": {
        "status": "draft",
        "uses": 0,
        "p0_rate": null
      },
      "params_json_schema": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "description": "素材路径，相对项目 public/ 目录（由 asset_use 复制进来），如 assets/phone-charging.webp"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ],
            "default": "image"
          },
          "move": {
            "type": "string",
            "enum": [
              "in",
              "out",
              "left",
              "right",
              "none"
            ],
            "default": "in",
            "description": "缓慢推拉 / 平移（Ken Burns）"
          },
          "focus": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "default": {
              "x": 0.5,
              "y": 0.5
            },
            "description": "推镜的中心"
          },
          "dim": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.8,
            "default": 0,
            "description": "压暗，便于叠加文字"
          },
          "callouts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "number",
                  "minimum": 0,
                  "description": "相对本段起点的秒数"
                },
                "text": {
                  "type": "string"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "accent",
                    "accent2",
                    "positive",
                    "negative",
                    "fg"
                  ],
                  "default": "accent2"
                }
              },
              "required": [
                "at",
                "text",
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "default": []
          },
          "box": {
            "type": "object",
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "w": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "h": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "at",
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false,
            "description": "在指定时刻描出的高亮框"
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "path": "library/blocks/footage-window"
    },
    {
      "id": "block/mg-diagram@0.1.0",
      "kind": "block",
      "title": "黑底图解",
      "summary": "节点 + 连线 + 分步揭示；连线可为箭头或流动粒子，节点可在指定时刻脉冲强调",
      "tags": {
        "shot_type": [
          "diagram",
          "process-flow"
        ],
        "metaphor": [
          "flow-path",
          "contrast-split",
          "cause-effect-arrow"
        ],
        "emphasis_treatment": [
          "motion-pop",
          "box"
        ],
        "aspect": [
          "9:16",
          "16:9"
        ]
      },
      "entry": "./index.tsx",
      "params_schema": "./schema.ts",
      "constraints": {
        "duration_s": [
          1.5,
          6
        ],
        "max_nodes": 12
      },
      "examples": [
        {
          "name": "离子流动",
          "duration_s": 3.5,
          "params": {
            "title": "充电时",
            "nodes": [
              {
                "id": "pos",
                "glyph": "+",
                "label": "正极",
                "x": 0.22,
                "y": 0.55,
                "size": "lg",
                "color": "negative"
              },
              {
                "id": "neg",
                "glyph": "−",
                "label": "负极",
                "x": 0.78,
                "y": 0.55,
                "size": "lg",
                "color": "accent"
              }
            ],
            "edges": [
              {
                "from": "pos",
                "to": "neg",
                "label": "锂离子",
                "style": "flow",
                "color": "fgMuted"
              }
            ],
            "steps": [
              {
                "at": 0.2,
                "show": [
                  "pos"
                ]
              },
              {
                "at": 0.6,
                "show": [
                  "neg"
                ]
              },
              {
                "at": 1.1,
                "show": [
                  "pos>neg"
                ]
              },
              {
                "at": 2.2,
                "emphasize": [
                  "neg"
                ]
              }
            ]
          }
        }
      ],
      "implements": [
        "recipe/process-reveal"
      ],
      "provenance": {
        "source": "self-made",
        "license": "自有",
        "reference": "analysis/chaping（黑底 MG 图解段，flow-path / contrast-split）"
      },
      "quality": {
        "status": "draft",
        "uses": 0,
        "p0_rate": null
      },
      "params_json_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "内容区顶部的小标题（可选）"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "description": "节点下方 / 内部的文字"
                },
                "glyph": {
                  "type": "string",
                  "description": "圆形节点内的符号，如 + − e⁻ Li⁺"
                },
                "shape": {
                  "type": "string",
                  "enum": [
                    "circle",
                    "pill",
                    "box"
                  ],
                  "default": "circle"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "内容区内的水平位置（0–1）"
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "内容区内的垂直位置（0–1）"
                },
                "size": {
                  "type": "string",
                  "enum": [
                    "sm",
                    "md",
                    "lg"
                  ],
                  "default": "md"
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "fg",
                    "fgMuted",
                    "accent",
                    "accent2",
                    "positive",
                    "negative"
                  ],
                  "default": "fg"
                }
              },
              "required": [
                "id",
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 12
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "line",
                    "arrow",
                    "flow"
                  ],
                  "default": "arrow",
                  "description": "flow：沿线流动的粒子，表示物质 / 能量 / 电荷流动"
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "fg",
                    "fgMuted",
                    "accent",
                    "accent2",
                    "positive",
                    "negative"
                  ],
                  "default": "fgMuted"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "default": []
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "number",
                  "minimum": 0,
                  "description": "相对本段起点的秒数"
                },
                "show": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "此时出现的节点 / 边（边的 id 为 from>to）"
                },
                "emphasize": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "此时被强调（脉冲光环）的节点"
                }
              },
              "required": [
                "at"
              ],
              "additionalProperties": false
            },
            "default": [],
            "description": "分步揭示；为空时全部元素依次入场"
          }
        },
        "required": [
          "nodes"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "path": "library/blocks/mg-diagram"
